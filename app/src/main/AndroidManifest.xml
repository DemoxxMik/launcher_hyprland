<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lecture de l'agenda (permission « dangereuse » : demandée à l'exécution, voir l'étape 5d) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Widget « thème » (étape 8.7) : changer le fond d'écran (permission normale) -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Widget « thème » : écrire le choix de palette Material You. Réservée au système : à accorder une fois
         par adb shell pm grant com.example.launcher_hyprland android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ : sans ceci, queryIntentActivities ne voit pas les autres apps (lanceur d'apps) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher_hyprland">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Launcher_hyprland"
            android:windowSoftInputMode="adjustResize">
            <!-- Écran d'accueil -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Garde aussi l'icône dans le tiroir d'apps (pratique pour tester) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
